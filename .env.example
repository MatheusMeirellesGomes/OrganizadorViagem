# Projeto Supabase > Project Settings > API (ou Connect).
# URL do projeto, por exemplo https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=
# Chave PÚBLICA: "anon" (legacy) ou "publishable" (sb_publishable_...).
# Nunca coloque aqui a service_role nem a sb_secret_.
VITE_SUPABASE_ANON_KEY=

# Catálogo (opcional). Sem configurar nada, atrações vêm da Wikipédia/Wikidata
# e restaurantes do Nominatim público (OpenStreetMap), dentro da política de uso.
# Servidor Nominatim próprio ou contratado (compatível com /search), ou "off"
# para desligar a busca no OpenStreetMap:
VITE_NOMINATIM_URL=
# Servidor Overpass próprio (HTTPS + CORS). Se configurado, restaurantes vêm dele.
# Não use as instâncias públicas: estão sobrecarregadas.
VITE_OVERPASS_URL=

# Assistente de roteiro com IA (opcional, Etapa 15). "on" mostra o painel.
# A chave da Anthropic NUNCA fica aqui: ela vai como segredo da função
# supabase/functions/assistente (supabase secrets set ANTHROPIC_API_KEY=...).
VITE_ASSISTENTE=
