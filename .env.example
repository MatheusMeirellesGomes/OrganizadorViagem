# Projeto Supabase > Project Settings > API (ou Connect).
# URL do projeto, por exemplo https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=
# Chave PÚBLICA: "anon" (legacy) ou "publishable" (sb_publishable_...).
# Nunca coloque aqui a service_role nem a sb_secret_.
VITE_SUPABASE_ANON_KEY=

# Catálogo: endpoint HTTPS Overpass próprio/contratado com CORS, sem segredo.
# Em desenvolvimento local, consultas manuais usam a instância pública.
# Em produção não usamos instância pública como backend de um produto.
VITE_OVERPASS_URL=
